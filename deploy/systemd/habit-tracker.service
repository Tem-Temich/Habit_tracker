[Unit]
Description=Habit Tracker Gunicorn
After=network.target

[Service]
User=deploy
Group=www-data
WorkingDirectory=/opt/habit_tracker
EnvironmentFile=/opt/habit_tracker/.env
ExecStart=/opt/habit_tracker/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
