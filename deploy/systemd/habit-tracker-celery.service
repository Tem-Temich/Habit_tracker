[Unit]
Description=Habit Tracker Celery Worker
After=network.target redis-server.service

[Service]
User=deploy
Group=www-data
WorkingDirectory=/opt/habit_tracker
EnvironmentFile=/opt/habit_tracker/.env
ExecStart=/opt/habit_tracker/.venv/bin/celery -A config worker -l info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
